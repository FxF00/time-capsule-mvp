# Private key for deployment (DO NOT COMMIT - use a burner wallet for testnet)
PRIVATE_KEY=0x_your_private_key_here

# Polygon Mumbai RPC (optional - has a fallback)
POLYGON_MUMBAI_RPC=https://rpc-mumbai.maticvigil.com

# Polygon Mainnet RPC (optional - has a fallback)
POLYGON_RPC=https://polygon-rpc.com

# Polygonscan API Key (required for contract verification)
# Get one free at https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
