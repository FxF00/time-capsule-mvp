# Sepolia Testnet RPC (public, no API key needed)
SEPOLIA_RPC=https://rpc.sepolia.org

# Deployer private key (DANGER: never commit this!)
# Use a fresh account with Sepolia ETH from https://sepoliafaucet.com
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# Etherscan API Key (required for contract verification)
# Get free at https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here
