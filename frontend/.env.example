# Frontend environment variables (must be prefixed with VITE_)
# Vite automatically exposes these to the client via import.meta.env

# TimeCapsuleVault contract address on Polygon (filled after deployment)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000001

# web3.storage API token for IPFS message uploads (optional for create flow)
# Get a free token at https://web3.storage/
VITE_WEB3_STORAGE_TOKEN=your_web3_storage_token_here
